<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:scottPlot="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
        x:Class="AutoValentia.GraphWindow"
        Title="Latency plots"
        Icon="/Assets/AutoValentia.ico"
        Width="1050"
        Height="720"
        MinWidth="760"
        MinHeight="540"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="24" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="14">
    <StackPanel Spacing="4">
      <TextBlock x:Name="TitleText" FontSize="26" FontWeight="SemiBold" />
      <TextBlock x:Name="SubtitleText"
                 Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                 TextWrapping="Wrap" />
    </StackPanel>

    <Border Grid.Row="1"
            Padding="8"
            Background="White"
            BorderBrush="{DynamicResource SystemControlOutlineBaseLowBrush}"
            BorderThickness="1"
            CornerRadius="8">
      <scottPlot:AvaPlot x:Name="LatencyPlot" />
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="20">
      <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <Border Width="14"
                  Height="14"
                  Background="#218739"
                  CornerRadius="7"
                  VerticalAlignment="Center" />
          <TextBlock x:Name="SafeLegendText" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="7">
          <Border Width="14"
                  Height="14"
                  Background="Black"
                  CornerRadius="7"
                  VerticalAlignment="Center" />
          <TextBlock x:Name="DangerLegendText" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock x:Name="SemDescriptionText"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                   VerticalAlignment="Center" />
      </StackPanel>

      <Button x:Name="ExportImageButton"
              Grid.Column="1"
              Padding="14,8"
              Click="ExportImageButton_Click" />
    </Grid>

    <TextBlock Grid.Row="3"
               x:Name="ExportStatusText"
               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
               TextWrapping="Wrap" />
  </Grid>
</Window>
