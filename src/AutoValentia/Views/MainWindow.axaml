<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AutoValentia.MainWindow"
        Title="AutoValentia"
        Icon="/Assets/AutoValentia.ico"
        Width="980"
        Height="700"
        MinWidth="720"
        MinHeight="540"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="28" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="18">
    <StackPanel Spacing="5">
      <TextBlock FontSize="30" FontWeight="SemiBold" Text="AutoValentia" />
      <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                 Text="Preparación y revisión de ensayos conductuales." />
    </StackPanel>

    <Border Grid.Row="1"
            Padding="16"
            Background="{DynamicResource SystemControlHighlightAltLowBrush}"
            BorderBrush="{DynamicResource SystemControlHighlightAltAccentBrush}"
            BorderThickness="1"
            CornerRadius="8">
      <StackPanel Spacing="6">
        <TextBlock FontWeight="SemiBold" Text="1. Selecciona los archivos MATLAB" />
        <TextBlock Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                   Text="La app prepara automáticamente los archivos seleccionados para crear el Excel de revisión." />
      </StackPanel>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="14">
      <Border Padding="12" BorderBrush="{DynamicResource SystemControlOutlineBaseLowBrush}" BorderThickness="1" CornerRadius="8">
        <ListBox x:Name="FilesListBox"
                 SelectionChanged="FilesListBox_SelectionChanged">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="10,7" />
            </Style>
          </ListBox.Styles>
        </ListBox>
      </Border>

      <StackPanel Grid.Column="1" Spacing="9" VerticalAlignment="Top">
        <Button x:Name="SelectFilesButton" MinWidth="180" Click="SelectFilesButton_Click" Content="Seleccionar .mat…" />
        <Button x:Name="RemoveButton" MinWidth="180" Click="RemoveButton_Click" Content="Quitar de la lista" />
        <Button x:Name="ExportReviewButton" MinWidth="180" Click="ExportReviewButton_Click" Content="Crear Excel de revisión…" />
        <Button x:Name="GraphButton" MinWidth="180" Click="GraphButton_Click" Content="Ver gráficas…" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="3">
      <TextBlock x:Name="StatusText"
                 FontWeight="SemiBold"
                 TextWrapping="Wrap" />
    </Grid>
  </Grid>
</Window>
